package ui

import (
	"strconv"
	"strings"
)

// NavItem is one sidebar link. Group is its heading; items of one group are listed together.
type NavItem struct{ Label, Href, Group, Icon string }

// LayoutData configures the page shell. Bare is the logged-out shell (the login
// page): a centered column with no nav, no logout and no hx-headers.
type LayoutData struct {
	Title     string
	Bare      bool
	CSRF      string
	Nav       []NavItem
	Active    string // Href of the current nav item
	LogoutURL string
	// PasswordURL, when set, adds a "Password" link to the top bar.
	PasswordURL string
}

// htmxConfig makes htmx swap 400, 404, 409, 422, 429, 500 and 502 responses like successes (PLAN 8.2),
// because handlers answer these with an error fragment; 401 and 403 carry HX-Redirect and stay errors. htmx indicator styles are off because our CSS styles .htmx-request.
const htmxConfig = `{"includeIndicatorStyles":false,"responseHandling":[{"code":"400|404|409|422|429|500|502","swap":true},{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"[45]..","swap":false,"error":true}]}`

// appScripts are the JS modules every page of the shell loads (after htmx).
var appScripts = []string{"js/theme.js", "js/dialog.js", "js/clipboard.js", "js/toast.js", "js/shortcuts.js", "js/nav.js", "js/forms.js", "js/menu.js", "js/password.js"}

// bodyAttrs returns the attributes of <body>: the CSRF header that htmx sends. The bare shell has none.
func bodyAttrs(d LayoutData) templ.Attributes {
	if d.Bare {
		return nil
	}
	h, _ := templ.JSONString(map[string]string{"X-CSRF-Token": d.CSRF}) //nolint: map of strings cannot fail
	return templ.Attributes{"hx-headers": h}
}

// navGroup is a heading with its nav items.
type navGroup struct {
	Name  string
	Items []NavItem
}

// navGroups splits the items into runs of the same group, keeping their order.
func navGroups(items []NavItem) []navGroup {
	var out []navGroup
	for _, it := range items {
		if n := len(out); n == 0 || out[n-1].Name != it.Group {
			out = append(out, navGroup{Name: it.Group})
		}
		out[len(out)-1].Items = append(out[len(out)-1].Items, it)
	}
	return out
}

// navAttrs marks the current item for assistive technology and for the active style.
func navAttrs(it NavItem, active string) templ.Attributes {
	if it.Href == active {
		return templ.Attributes{"aria-current": "page"}
	}
	return nil
}

// crumbs is the breadcrumb: the section of the nav, then the page title when it is a deeper page.
func crumbs(d LayoutData) []string {
	for _, it := range d.Nav {
		if it.Href == d.Active {
			if it.Label == d.Title {
				return []string{it.Label}
			}
			return []string{it.Label, d.Title}
		}
	}
	// When Active matches no nav item, or is empty, the crumb is the page title alone.
	if d.Title == "" {
		return nil
	}
	return []string{d.Title}
}

// crumbAttrs marks the last breadcrumb as the current page.
func crumbAttrs(last bool) templ.Attributes {
	if last {
		return templ.Attributes{"aria-current": "page"}
	}
	return nil
}

// themePressed returns the aria-pressed value of the dark theme toggle.
func themePressed(theme string) string { return strconv.FormatBool(theme == "air-dark") }

// Layout is the page shell: head, sidebar, top bar, the page content (children), the confirm dialog and the toast area.
templ Layout(d LayoutData) {
	{{ crumbList := crumbs(d) }}
	{{ env := EnvFrom(ctx) }}
	<!DOCTYPE html>
	<html lang="en" dir="ltr" data-theme={ env.Theme }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content={ htmxConfig }/>
			<title>{ env.TabTitle(d.Title) }</title>
			<link rel="stylesheet" href={ env.Asset("app.css") }/>
			if !d.Bare {
				<script src={ env.Asset("htmx.min.js") } defer></script>
				for _, s := range appScripts {
					<script type="module" src={ env.Asset(s) }></script>
				}
			}
		</head>
		<body { bodyAttrs(d)... }>
			if d.Bare {
				<main class="l-center l-glow">
					<div class="l-login">
						<div id="flash" aria-live="polite"></div>
						{ children... }
					</div>
				</main>
			} else {
				<div class="l-shell">
					<aside id="sidebar" class="l-sidebar">
						<a class="l-brand" href="/admin/members">
							<span class="l-brand__mark" aria-hidden="true"></span>
							HotspotPlus Lite
							if env.BusinessName != "" {
								<span class="l-brand__name">{ env.BusinessName }</span>
							}
						</a>
						<nav aria-label="Main" class="l-nav">
							for _, g := range navGroups(d.Nav) {
								<div>
									<p class="l-nav__heading">{ g.Name }</p>
									<ul class="l-nav__list">
										for _, n := range g.Items {
											<li>
												<a href={ templ.SafeURL(n.Href) } class="l-nav__link" { navAttrs(n, d.Active)... }>
													@Icon(n.Icon)
													{ n.Label }
												</a>
											</li>
										}
									</ul>
								</div>
							}
						</nav>
					</aside>
					<div class="l-main">
						<header class="l-topbar">
							<button type="button" class="c-icon-btn l-topbar__menu" data-nav-toggle aria-controls="sidebar" aria-expanded="false" aria-label="Menu">
								@Icon("menu")
							</button>
							<nav aria-label="Breadcrumb" class="l-crumbs">
								<ol>
									for i, c := range crumbList {
										if i > 0 {
											<li aria-hidden="true">/</li>
										}
										<li { crumbAttrs(i == len(crumbList)-1)... }>{ c }</li>
									}
								</ol>
							</nav>
							<div class="l-tools">
								<button type="button" class="c-btn" data-variant="ghost" data-theme-toggle data-themes={ strings.Join(Themes, " ") } aria-pressed={ themePressed(env.Theme) } aria-label="Switch theme">
									@Icon("sun")
									Theme
								</button>
								if d.PasswordURL != "" {
									<a class="c-btn" data-variant="ghost" href={ templ.SafeURL(d.PasswordURL) }>
										@Icon("key")
										Password
									</a>
								}
								if d.LogoutURL != "" {
									<button type="button" class="c-btn" hx-post={ d.LogoutURL }>
										@Icon("logout")
										Log out
									</button>
								}
							</div>
						</header>
						<main class="l-page">
							<div id="flash" aria-live="polite"></div>
							{ children... }
						</main>
					</div>
				</div>
				@ConfirmModal()
				@Toast()
			}
		</body>
	</html>
}

// Icon is a small line icon (24x24 grid; size, stroke and color come from CSS).
templ Icon(name string) {
	<svg class="c-icon" viewBox="0 0 24 24" aria-hidden="true">
		switch name {
			case "users":
				<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
				<circle cx="9" cy="7" r="4"></circle>
				<path d="M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"></path>
			case "ticket":
				<path d="M3 9a2 2 0 0 0 0 6v3a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1v-3a2 2 0 0 1 0-6V6a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1z"></path>
				<path d="M13 5v2M13 11v2M13 17v2"></path>
			case "wifi":
				<path d="M5 12.5a10 10 0 0 1 14 0M2 9a15 15 0 0 1 20 0M8.5 16a5 5 0 0 1 7 0M12 20h.01"></path>
			case "chart":
				<path d="M3 3v18h18M8 17v-5M13 17V8M18 17v-9"></path>
			case "layers":
				<path d="m12 2 10 5-10 5L2 7zM2 12l10 5 10-5M2 17l10 5 10-5"></path>
			case "router":
				<rect x="2" y="14" width="20" height="7" rx="2"></rect>
				<path d="M6 17.5h.01M10 17.5h.01M12 14V9M8.5 6.5a5 5 0 0 1 7 0"></path>
			case "settings":
				<path d="M4 6h8M18 6h2M4 12h2M12 12h8M4 18h10M20 18h0"></path>
				<circle cx="15" cy="6" r="2"></circle>
				<circle cx="9" cy="12" r="2"></circle>
				<circle cx="17" cy="18" r="2"></circle>
			case "logout":
				<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"></path>
			case "key":
				<path d="m21 2-9.6 9.6M15.5 7.5l3 3L22 7l-3-3"></path>
				<circle cx="7.5" cy="15.5" r="5.5"></circle>
			case "menu":
				<path d="M4 6h16M4 12h16M4 18h16"></path>
			case "search":
				<circle cx="11" cy="11" r="7"></circle>
				<path d="m20 20-3.5-3.5"></path>
			case "plus":
				<path d="M12 5v14M5 12h14"></path>
			case "more":
				<circle cx="5" cy="12" r="1"></circle>
				<circle cx="12" cy="12" r="1"></circle>
				<circle cx="19" cy="12" r="1"></circle>
			case "sun":
				<circle cx="12" cy="12" r="4"></circle>
				<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
			case "close":
				<path d="M18 6 6 18M6 6l12 12"></path>
			case "copy":
				<rect x="9" y="9" width="12" height="12" rx="2"></rect>
				<path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
			case "check":
				<path d="m5 12 5 5 9-10"></path>
		}
	</svg>
}

// PageHeader is the page title; its children (buttons) sit on the right.
templ PageHeader(title string) {
	<div class="l-page-head">
		<h1>{ title }</h1>
		<div class="l-cluster">
			{ children... }
		</div>
	</div>
}

// Section is a titled block of a page.
templ Section(title string) {
	<section class="l-section">
		<h2>{ title }</h2>
		{ children... }
	</section>
}

// Card is a panel with padding; use it for sections.
templ Card() {
	<div class="c-card" data-pad>
		{ children... }
	</div>
}

// FormCard is the narrow card that wraps a form. attrs holds id and the hx-* attributes.
templ FormCard(attrs templ.Attributes) {
	<form class="c-card c-form l-narrow" { attrs... }>
		{ children... }
	</form>
}

// CardTitle is the heading of a Card.
templ CardTitle(title string) {
	<h2 class="c-card__title">{ title }</h2>
}

// EmptyState replaces a table when there is nothing to show; children may hold a link.
templ EmptyState(msg string) {
	<div class="c-card c-empty l-gap-bottom">
		<p>{ msg }</p>
		{ children... }
	</div>
}

// Actions is a row of buttons.
templ Actions() {
	<div class="l-cluster">
		{ children... }
	</div>
}

// FilterBar is a GET form that holds the fields of a list. Without JavaScript it submits as a
// plain GET; attrs add the hx-* attributes that update the list in place.
templ FilterBar(id, action string, attrs templ.Attributes) {
	<form id={ id } class="l-toolbar" method="get" action={ action } { attrs... }>
		{ children... }
	</form>
}

// Refresher reloads a list region when an event arrives on the body (sent with HX-Trigger after a
// change). url must be the list's current address, so the filter and page survive. It lives inside
// the region it reloads and is replaced with it.
templ Refresher(url, event, target string) {
	<div hidden hx-get={ url } hx-trigger={ event + " from:body" } hx-target={ target } hx-swap="innerHTML"></div>
}

// Pill is a status: a dot and a text. status is "active", "expiring", "expired" or "disabled".
templ Pill(status, text string) {
	<span class="c-pill" data-status={ status }>{ text }</span>
}

// OnlineDot is the online/offline dot. It is not color-only: it has a role and a label.
templ OnlineDot(on bool) {
	<span class="c-dot" { dotAttrs(on)... } title={ onlineTitle(on) } role="img" aria-label={ onlineLabel(on) }></span>
}

// dotAttrs returns data-on for an online dot.
func dotAttrs(on bool) templ.Attributes {
	if on {
		return templ.Attributes{"data-on": true}
	}
	return nil
}

// onlineLabel returns the accessible label of the online dot.
func onlineLabel(on bool) string {
	if on {
		return "Online"
	}
	return "Offline"
}

// onlineTitle returns the tooltip of the online dot.
func onlineTitle(on bool) string {
	if on {
		return "online"
	}
	return "offline"
}

// buttonVariant maps the kind names used by pages to the data-variant of c-btn.
func buttonVariant(kind string) string {
	switch kind {
	case "primary", "danger", "ghost":
		return kind
	}
	return "default"
}

// Button is a <button>; kind is "primary", "secondary", "danger" or "ghost". Attrs carry type, hx-* and data-*.
templ Button(kind, label string, attrs templ.Attributes) {
	<button class="c-btn" data-variant={ buttonVariant(kind) } { buttonAttrs(attrs)... }>{ label }</button>
}

// LinkButton is a link that looks like a button.
templ LinkButton(kind, href, label string, attrs templ.Attributes) {
	<a class="c-btn" data-variant={ buttonVariant(kind) } href={ templ.SafeURL(href) } { linkAttrs(attrs)... }>{ label }</a>
}

// IconButton is a square button with an icon only; label is its accessible name.
templ IconButton(icon, label string, attrs templ.Attributes) {
	<button class="c-icon-btn" aria-label={ label } { buttonAttrs(attrs)... }>
		@Icon(icon)
	</button>
}

// linkAttrs drops "class" so callers cannot replace the button look.
func linkAttrs(in templ.Attributes) templ.Attributes {
	out := templ.Attributes{}
	for k, v := range in {
		if k != "class" && k != "href" {
			out[k] = v
		}
	}
	return out
}

// buttonAttrs is linkAttrs plus a type limited to button, submit or reset (default button).
// A submit button disables itself while its htmx request is running.
func buttonAttrs(in templ.Attributes) templ.Attributes {
	out := linkAttrs(in)
	switch in["type"] {
	case "submit":
		out["type"] = "submit"
		out["hx-disabled-elt"] = "this"
	case "reset":
		out["type"] = "reset"
	default:
		out["type"] = "button"
	}
	return out
}

// Flash is a message box; kind is "ok", "warn" or "error".
templ Flash(kind, msg string) {
	<div class="c-notice" data-kind={ noticeKind(kind) }>{ msg }</div>
}

// noticeKind returns kind when it is "ok" or "warn", else "error".
func noticeKind(kind string) string {
	switch kind {
	case "ok", "warn":
		return kind
	}
	return "error"
}

// ErrorFragment is the body of a 4xx htmx response that is swapped into #flash.
templ ErrorFragment(msg string) {
	<div class="c-notice" data-kind="error" role="alert">{ msg }</div>
}

// FieldError is the error message of one field, as a response body.
templ FieldError(name, msg string) {
	if msg != "" {
		<p class="c-field__error" id={ "err-" + name } data-error-for={ name }>{ msg }</p>
	}
}

// FieldProps describes a Field.
type FieldProps struct {
	Label, Name, Type, Value, Error, Hint string
	Attrs                                 templ.Attributes
}

// inputType returns t, or "text" when t is empty.
func inputType(t string) string {
	if t == "" {
		return "text"
	}
	return t
}

// invalidAttrs marks a control whose error message is shown.
func invalidAttrs(name, err string) templ.Attributes {
	if err == "" {
		return nil
	}
	return templ.Attributes{"aria-invalid": "true", "aria-describedby": "err-" + name}
}

// Field is a labelled text-like input with its hint and error message.
templ Field(p FieldProps) {
	<div class="c-field">
		<label class="c-field__label" for={ p.Name }>{ p.Label }</label>
		@InputControl(p)
		@FieldHint(p.Hint)
		@FieldError(p.Name, p.Error)
	</div>
}

// InputControl is the bare <input>, reused inside composite fields.
templ InputControl(p FieldProps) {
	<input id={ p.Name } name={ p.Name } type={ inputType(p.Type) } value={ p.Value } class="c-input" { invalidAttrs(p.Name, p.Error)... } { p.Attrs... }/>
}

// NamedError is the error message of one control inside a composite field.
type NamedError struct{ Name, Msg string }

// PairProps describes a FieldPair.
type PairProps struct {
	Label, For, Hint string
	Errors           []NamedError
}

// FieldPair is a labelled field holding two controls side by side (the
// children), with one hint and the errors of each control.
templ FieldPair(p PairProps) {
	<div class="c-field">
		<label class="c-field__label" for={ p.For }>{ p.Label }</label>
		<div class="c-field__pair">
			{ children... }
		</div>
		@FieldHint(p.Hint)
		for _, e := range p.Errors {
			@FieldError(e.Name, e.Msg)
		}
	</div>
}

// FieldHint is the hint text under a field.
templ FieldHint(h string) {
	if h != "" {
		<p class="c-field__hint">{ h }</p>
	}
}

// Option is one entry of a select.
type Option struct{ Value, Label string }

// SelectProps describes a Select.
type SelectProps struct {
	Label, Name, Value, Error, Hint string
	Options                         []Option
}

// Select is a labelled select with its error message.
templ Select(p SelectProps) {
	<div class="c-field">
		<label class="c-field__label" for={ p.Name }>{ p.Label }</label>
		@SelectControl(p)
		@FieldHint(p.Hint)
		@FieldError(p.Name, p.Error)
	</div>
}

// SelectControl is the bare <select>, reused inside composite fields.
templ SelectControl(p SelectProps) {
	<select id={ p.Name } name={ p.Name } class="c-select" { invalidAttrs(p.Name, p.Error)... }>
		for _, o := range p.Options {
			<option value={ o.Value } selected?={ o.Value == p.Value }>{ o.Label }</option>
		}
	</select>
}

// TextareaProps describes a Textarea.
type TextareaProps struct{ Label, Name, Value, Error, Hint string }

// Textarea is a labelled textarea with its hint and error message.
templ Textarea(p TextareaProps) {
	<div class="c-field">
		<label class="c-field__label" for={ p.Name }>{ p.Label }</label>
		<textarea id={ p.Name } name={ p.Name } rows="4" class="c-input" { invalidAttrs(p.Name, p.Error)... }>{ p.Value }</textarea>
		@FieldHint(p.Hint)
		@FieldError(p.Name, p.Error)
	</div>
}

// CheckboxProps describes a Checkbox.
type CheckboxProps struct {
	Label, Name, Hint string
	Checked           bool
}

// Checkbox is a labelled checkbox.
templ Checkbox(p CheckboxProps) {
	<div class="c-field">
		<label class="c-check" for={ "f-" + p.Name }>
			<input type="checkbox" id={ "f-" + p.Name } name={ p.Name } value="on" checked?={ p.Checked }/>
			{ p.Label }
		</label>
		@FieldHint(p.Hint)
	</div>
}

// SearchProps describes the search box. Attrs carry hx-* and name-specific attributes.
type SearchProps struct {
	Name, Value, Placeholder string
	Attrs                    templ.Attributes
}

// Search is a text input with a search icon and a "/" hint. The "/" key focuses it (shortcuts.js).
templ Search(p SearchProps) {
	<div class="c-search">
		<span class="c-search__icon">
			@Icon("search")
		</span>
		<input class="c-input" type="search" id={ p.Name } name={ p.Name } value={ p.Value } placeholder={ p.Placeholder } aria-label={ p.Placeholder } autocomplete="off" data-search { p.Attrs... }/>
		<kbd class="c-search__hint" aria-hidden="true">/</kbd>
	</div>
}

// ChipProps describes a filter link. Count is shown after the label when not empty.
type ChipProps struct {
	Label, Href, Count string
	Selected           bool
	Attrs              templ.Attributes
}

// chipAttrs returns the link attributes of a chip.
func chipAttrs(p ChipProps) templ.Attributes {
	out := templ.Attributes{}
	for k, v := range p.Attrs {
		out[k] = v
	}
	if p.Selected {
		out["aria-current"] = "true"
	}
	return out
}

// Chip is a filter pill that links to the filtered list. The current one has aria-current="true".
templ Chip(p ChipProps) {
	<a class="c-chip" href={ templ.SafeURL(p.Href) } { chipAttrs(p)... }>
		{ p.Label }
		if p.Count != "" {
			<span class="c-chip__count">{ p.Count }</span>
		}
	</a>
}

// Meter is a usage bar on a native <meter>: accent below 80 %, warning from 80 %, red when full.
// It has no text inside: put the figures next to it.
templ Meter(value, max float64, label string) {
	<meter class="c-meter" value={ strconv.FormatFloat(value, 'f', -1, 64) } min="0" max={ strconv.FormatFloat(max, 'f', -1, 64) } low={ strconv.FormatFloat(max*0.8, 'f', -1, 64) } high={ strconv.FormatFloat(max*0.9999, 'f', -1, 64) } optimum="0" aria-label={ label }></meter>
}

// Table is a card with a table: caption (for screen readers), header row, and your <tr> children in the body.
// Give each <td> a data-label (shown on small screens) and data-slot="actions" for a button cell.
templ Table(caption string, headers []string) {
	<div class="c-card c-table-wrap">
		<table class="c-table">
			<caption class="u-sr-only">{ caption }</caption>
			<thead>
				<tr>
					for _, h := range headers {
						<th scope="col">{ h }</th>
					}
				</tr>
			</thead>
			<tbody>
				{ children... }
			</tbody>
		</table>
	</div>
}

// ConfirmDelete is a button that asks for confirmation (the shared modal), then sends DELETE;
// a 409 body is swapped into #flash, a success answers HX-Redirect.
templ ConfirmDelete(label, url, confirm string) {
	@Button("danger", label, templ.Attributes{"type": "button", "hx-delete": url, "hx-confirm": confirm, "hx-target": "#flash", "hx-swap": "innerHTML"})
}

// ConfirmAction is a button that asks for confirmation, then sends method (post|put|delete) to url.
// Responses are swapped into #flash (errors and conflicts); a success answers HX-Redirect.
templ ConfirmAction(label, method, url, confirm string) {
	@Button("secondary", label, confirmAttrs(method, url, confirm))
}

// confirmAttrs returns the htmx attributes of a button that asks for confirmation first.
func confirmAttrs(method, url, confirm string) templ.Attributes {
	return templ.Attributes{"type": "button", "hx-" + method: url, "hx-confirm": confirm, "hx-target": "#flash", "hx-swap": "innerHTML"}
}

// ConfirmModal is the one shared confirm dialog. dialog.js fills it with the hx-confirm text of a button.
templ ConfirmModal() {
	<dialog id="confirm-modal" class="c-modal" aria-labelledby="confirm-title">
		<h2 class="c-modal__title" id="confirm-title">Please confirm</h2>
		<p class="c-modal__text" data-confirm-text></p>
		<div class="c-modal__foot">
			<button type="button" class="c-btn" data-close value="cancel">Cancel</button>
			<button type="button" class="c-btn" data-variant="danger" data-close value="ok" autofocus>Confirm</button>
		</div>
	</dialog>
}

// Modal is a dialog with a title, text and your buttons as children (the gallery uses it; pages use ConfirmModal).
templ Modal(id, title, text string) {
	<dialog id={ id } class="c-modal" aria-labelledby={ id + "-title" }>
		<h2 class="c-modal__title" id={ id + "-title" }>{ title }</h2>
		<p class="c-modal__text">{ text }</p>
		<div class="c-modal__foot">
			{ children... }
		</div>
	</dialog>
}

// Toast is the message area. toast.js fills it when a "toast" event arrives (HX-Trigger).
templ Toast() {
	<div id="toast" class="c-toast" role="status" aria-live="polite"></div>
}

// Menu is a row-actions button with a popover list. Children are MenuItem and MenuSep.
templ Menu(id, label string) {
	<button type="button" class="c-icon-btn" popovertarget={ id } aria-label={ label } aria-haspopup="menu">
		@Icon("more")
	</button>
	<div id={ id } popover class="c-menu" role="menu">
		{ children... }
	</div>
}

// MenuItem is one entry of a Menu. Attrs carry hx-* attributes or a href (then it is a link).
templ MenuItem(label string, danger bool, attrs templ.Attributes) {
	<button class="c-menu__item" role="menuitem" { menuItemAttrs(danger, attrs)... }>{ label }</button>
}

// menuItemAttrs returns the attributes of a menu item.
func menuItemAttrs(danger bool, in templ.Attributes) templ.Attributes {
	out := buttonAttrs(in)
	if danger {
		out["data-danger"] = true
	}
	return out
}

// MenuSep is a line between groups of menu items.
templ MenuSep() {
	<hr class="c-menu__sep"/>
}

// Sheet is a right-side drawer. Children are SheetBody and SheetFoot. Open it with a button that has data-open-dialog="id".
templ Sheet(id, title string) {
	<dialog id={ id } class="c-sheet" aria-labelledby={ id + "-title" }>
		<div class="c-sheet__head">
			<h2 class="c-sheet__title" id={ id + "-title" }>{ title }</h2>
			<button type="button" class="c-icon-btn" data-close aria-label="Close">
				@Icon("close")
			</button>
		</div>
		{ children... }
	</dialog>
}

// SheetHost is the one page-level sheet that htmx fills: pages open it by loading a fragment
// into its body (id+"-body"). dialog.js sets the title from the fragment's data-sheet-title,
// opens the dialog, and empties the body when it closes.
templ SheetHost(id string) {
	<dialog id={ id } class="c-sheet" data-sheet-host aria-labelledby={ id + "-title" }>
		<div class="c-sheet__head">
			<h2 class="c-sheet__title" id={ id + "-title" }></h2>
			<button type="button" class="c-icon-btn" data-close aria-label="Close">
				@Icon("close")
			</button>
		</div>
		<div class="c-sheet__body" id={ id + "-body" }></div>
	</dialog>
}

// SheetSection is a titled block inside a sheet body, set off by a line. attrs add data hooks.
templ SheetSection(title string, attrs templ.Attributes) {
	<section class="c-sheet__section" { attrs... }>
		<h3>{ title }</h3>
		{ children... }
	</section>
}

// SheetForm is a form inside a sheet: no card, no padding. attrs hold id and the hx-* attributes.
templ SheetForm(attrs templ.Attributes) {
	<form class="c-form" data-flush { attrs... }>
		{ children... }
	</form>
}

// SheetBody is the scrolling body of a Sheet.
templ SheetBody() {
	<div class="c-sheet__body">
		{ children... }
	</div>
}

// SheetFoot is the button row at the bottom of a Sheet.
templ SheetFoot() {
	<div class="c-sheet__foot">
		{ children... }
	</div>
}

// CredRow is one line of the credentials card. Key is a data-key hook for the value ("" = none).
type CredRow struct{ Label, Value, Key string }

// credKey returns the data-key attribute of a credentials row.
func credKey(k string) templ.Attributes {
	if k == "" {
		return nil
	}
	return templ.Attributes{"data-key": k}
}

// Credentials is what staff hands to a guest: the rows and a Copy button. copyText is what the button copies.
templ Credentials(rows []CredRow, copyText string) {
	<dl class="c-credentials">
		for _, r := range rows {
			<div class="c-credentials__row">
				<dt>{ r.Label }</dt>
				<dd { credKey(r.Key)... }>{ r.Value }</dd>
			</div>
		}
	</dl>
	@Button("secondary", "Copy details", templ.Attributes{"type": "button", "data-copy-text": copyText})
}

// PageProps describes a paginated list: the current page, the page count and a
// function that builds the link of any page (so filters survive paging).
type PageProps struct {
	Page, Pages int
	Href        func(page int) string
	// Target (a CSS selector such as "#member-list") makes the links update that region in place
	// with hx-get and hx-push-url. The href stays, so the links also work without JavaScript.
	Target string
}

// pageLink adds the htmx attributes to a pager link when the pager updates a region.
func pageLink(p PageProps, href string, extra templ.Attributes) templ.Attributes {
	out := templ.Attributes{}
	for k, v := range extra {
		out[k] = v
	}
	if p.Target != "" {
		out["hx-get"], out["hx-target"], out["hx-push-url"] = href, p.Target, "true"
	}
	return out
}

// pageNumbers lists the pages to link: the first, the last and two either side of the current one.
func pageNumbers(page, pages int) []int {
	var out []int
	for n := 1; n <= pages; n++ {
		if n == 1 || n == pages || (n >= page-2 && n <= page+2) {
			out = append(out, n)
		}
	}
	return out
}

// pageAttrs returns the attributes of a numbered pager link.
func pageAttrs(n, page int) templ.Attributes {
	if n == page {
		return templ.Attributes{"aria-current": "page"}
	}
	return nil
}

// stepAttrs is for Previous/Next: disabled at the ends.
func stepAttrs(target, page, pages int) templ.Attributes {
	if target < 1 || target > pages || target == page {
		return templ.Attributes{"aria-disabled": "true", "tabindex": "-1"}
	}
	return nil
}

// stepTarget returns target limited to 1..pages.
func stepTarget(target, pages int) int { return min(max(target, 1), pages) }

// Pagination renders the pager (Previous, page links, Next); nothing for a single page.
templ Pagination(p PageProps) {
	if p.Pages > 1 {
		<nav aria-label="Pages" class="c-pager">
			<a class="c-pager__link" data-step="prev" href={ templ.SafeURL(p.Href(stepTarget(p.Page-1, p.Pages))) } { pageLink(p, p.Href(stepTarget(p.Page-1, p.Pages)), stepAttrs(p.Page-1, p.Page, p.Pages))... }>Previous</a>
			for _, n := range pageNumbers(p.Page, p.Pages) {
				<a class="c-pager__link" data-page={ strconv.Itoa(n) } href={ templ.SafeURL(p.Href(n)) } { pageLink(p, p.Href(n), pageAttrs(n, p.Page))... }>{ strconv.Itoa(n) }</a>
			}
			<a class="c-pager__link" data-step="next" href={ templ.SafeURL(p.Href(stepTarget(p.Page+1, p.Pages))) } { pageLink(p, p.Href(stepTarget(p.Page+1, p.Pages)), stepAttrs(p.Page+1, p.Page, p.Pages))... }>Next</a>
		</nav>
	}
}

// CodeBlock shows read-only text (a script) in a box with a Copy button; the
// click is handled by clipboard.js (delegated on [data-copy-target]).
templ CodeBlock(id, text string) {
	<div class="c-code">
		<textarea class="c-input c-code__text" id={ id } data-script rows="18" readonly spellcheck="false">{ text }</textarea>
		<div>
			@Button("secondary", "Copy", templ.Attributes{"type": "button", "data-copy-target": id})
		</div>
	</div>
}

// Bar is one column of BarChart. Attrs are extra attributes on its <rect> (data hooks).
type Bar struct {
	Label string // shown under the first and last bar
	Value int64
	Tip   string // tooltip text
	Attrs templ.Attributes
}

// BarChart is a dependency-free bar chart: one inline SVG, bars scaled to top (0 = all empty),
// the first and last labels printed underneath. Bars use the accent color (currentColor).
templ BarChart(bars []Bar, top int64, caption string) {
	if len(bars) > 0 {
		<figure class="c-card c-chart">
			<svg class="c-chart__svg" viewBox={ barViewBox(len(bars)) } preserveAspectRatio="none" role="img" aria-label={ caption }>
				for i, b := range bars {
					<rect x={ strconv.Itoa(i*10 + 1) } y={ strconv.Itoa(100 - barHeight(b.Value, top)) } width="8" height={ strconv.Itoa(barHeight(b.Value, top)) } fill="currentColor" { b.Attrs... }>
						<title>{ b.Tip }</title>
					</rect>
				}
			</svg>
			<figcaption class="c-chart__caption">
				<span>{ bars[0].Label }</span>
				<span>{ caption }</span>
				<span>{ bars[len(bars)-1].Label }</span>
			</figcaption>
		</figure>
	}
}

// barViewBox returns the SVG view box for n bars.
func barViewBox(n int) string { return "0 0 " + strconv.Itoa(n*10) + " 100" }

// barHeight scales v to 0..100 against top; a non-zero value gets at least 1 so that it stays visible.
func barHeight(v, top int64) int {
	if v <= 0 || top <= 0 {
		return 0
	}
	return int(min(100, max(1, v*100/top)))
}
