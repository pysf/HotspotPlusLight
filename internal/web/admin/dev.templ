package admin

import "hotspotpluslight/internal/web/ui"

// galleryItem is one titled box of the component gallery.
templ galleryItem(title string) {
	<div class="c-gallery-item">
		<h3>{ title }</h3>
		<div class="l-cluster">
			{ children... }
		</div>
	</div>
}

// DevComponentsPage shows every component in every variant and state (HSP_DEV=1 only).
templ DevComponentsPage(l ui.LayoutData) {
	@ui.Layout(l) {
		@ui.PageHeader("Components")
		@galleryItem("Button") {
			@ui.Button("secondary", "Default", nil)
			@ui.Button("primary", "Primary", nil)
			@ui.Button("danger", "Delete (soft)", nil)
			@ui.Button("danger-solid", "Kick device", nil)
			@ui.Button("ghost", "Ghost", nil)
			@ui.Button("secondary", "Disabled", templ.Attributes{"disabled": true})
			@ui.Button("primary", "Loading", templ.Attributes{"data-loading": true})
			@ui.Button("secondary", "Small", templ.Attributes{"data-size": "sm"})
			@ui.LinkButton("secondary", "#", "Link button", nil)
		}
		@galleryItem("Button, block") {
			<div class="l-login">
				@ui.Button("primary", "Continue", templ.Attributes{"data-size": "block"})
			</div>
		}
		@galleryItem("Icon button") {
			@ui.IconButton("plus", "Add", nil)
			@ui.IconButton("x", "Close", nil)
			@ui.IconButton("copy", "Copy", nil)
			@ui.IconButton("more", "Disabled", templ.Attributes{"disabled": true})
		}
		@galleryItem("Field, input, select") {
			<div class="l-stack l-narrow">
				@ui.Field(ui.FieldProps{Label: "Username", Name: "g_user", Value: "alice", Hint: "A hint under the field."})
				@ui.Field(ui.FieldProps{Label: "With error", Name: "g_err", Value: "x", Error: "This value is not valid."})
				@ui.Select(ui.SelectProps{Label: "Plan", Name: "g_plan", Value: "b", Options: []ui.Option{{Value: "a", Label: "Basic"}, {Value: "b", Label: "Premium"}}})
				@ui.Checkbox(ui.CheckboxProps{Label: "Active", Name: "g_active", Checked: true})
			</div>
		}
		@galleryItem("Checkbox, switch, segmented control") {
			<label class="c-choice"><span class="c-hit"><input type="checkbox" class="c-check"/></span> Off</label>
			<label class="c-choice"><span class="c-hit"><input type="checkbox" class="c-check" checked/></span> On</label>
			<label class="c-choice"><span class="c-hit"><input type="checkbox" class="c-check" checked disabled/></span> Disabled</label>
			<label class="c-choice"><input type="checkbox" class="c-switch" role="switch"/> Off</label>
			<label class="c-choice"><input type="checkbox" class="c-switch" role="switch" checked/> On</label>
			<label class="c-choice"><input type="checkbox" class="c-switch" role="switch" disabled/> Disabled</label>
			<div class="l-narrow">
				@ui.SwitchRow(ui.CheckboxProps{Label: "Account enabled", Name: "g_enabled", Checked: true, Hint: "Turning it off disconnects the member's open sessions."})
			</div>
			<span class="c-seg" role="radiogroup" aria-label="Range">
				<button type="button" role="radio" aria-checked="false">7</button>
				<button type="button" role="radio" aria-checked="true">30</button>
				<button type="button" role="radio" aria-checked="false">90</button>
			</span>
		}
		@galleryItem("Input states") {
			<div class="l-stack l-narrow">
				<input class="c-input is-hover" value="Hover" aria-label="Hover"/>
				<input class="c-input is-focus" value="Focus" aria-label="Focus"/>
				<input class="c-input" value="Disabled" aria-label="Disabled" disabled/>
				<input class="c-input" value="Error" aria-label="Error" aria-invalid="true"/>
			</div>
		}
		@galleryItem("Search") {
			@ui.Search(ui.SearchProps{Name: "g_search", Placeholder: "Search members"})
		}
		@galleryItem("Chip") {
			@ui.Chip(ui.ChipProps{Label: "All", Count: "143", Href: "#", Selected: true})
			@ui.Chip(ui.ChipProps{Label: "Active", Count: "120", Href: "#"})
			@ui.Chip(ui.ChipProps{Label: "Expired", Count: "9", Href: "#"})
		}
		@galleryItem("Card, notice") {
			@ui.Card() {
				<p>Card content.</p>
			}
			@ui.Flash("ok", "Saved.")
			@ui.Flash("warn", "Check this.")
			@ui.Flash("error", "Something failed.")
			@ui.Flash("info", "Good to know.")
		}
		@galleryItem("Pill and online dot") {
			@ui.Pill("active", "Active")
			@ui.Pill("expiring", "Expiring")
			@ui.Pill("expired", "Expired")
			@ui.Pill("disabled", "Disabled")
			@ui.Pill("info", "Info")
			@ui.OnlineDot(true)
			@ui.OnlineDot(false)
			@ui.LiveStatus("Live, updated 4 s ago")
			<span class="c-badge u-nums">24</span>
		}
		@galleryItem("Meter") {
			<div class="l-narrow">
				@ui.Meter(2, 10, "2 of 10 GB")
				<br/>
				@ui.Meter(8.5, 10, "8.5 of 10 GB")
				<br/>
				@ui.Meter(10, 10, "10 of 10 GB")
			</div>
		}
		@galleryItem("Table") {
			@ui.Table("Sample", []string{"User", "Plan", "Usage", "Expires", "Status", ""}) {
				<tr>
					<td data-label="User">
						alice
						<div class="c-table__sub">9123456789</div>
					</td>
					<td data-label="Plan">
						Premium
						<div class="c-table__sub">5 Mbps</div>
					</td>
					<td data-label="Usage" class="u-nums">
						@ui.Meter(8.5, 10, "8.5 of 10 GB")
						8.5 GB / 10 GB
						<div class="c-table__sub">1.5 GB left</div>
					</td>
					<td data-label="Expires">
						2026-11-05
						<div class="c-table__sub">in 2 days</div>
					</td>
					<td data-label="Status">
						@ui.Pill("expiring", "Expiring")
						@ui.OnlineDot(true)
					</td>
					<td data-slot="actions">
						@ui.Menu("g-menu-row", "Row actions") {
							@ui.MenuItem("Edit", false, nil)
							@ui.MenuSep()
							@ui.MenuItem("Delete", true, nil)
						}
					</td>
				</tr>
				<tr>
					<td data-label="User">bob</td>
					<td data-label="Plan">Basic</td>
					<td data-label="Usage" class="u-nums">0 GB / unlimited</td>
					<td data-label="Expires">—</td>
					<td data-label="Status">
						@ui.Pill("disabled", "Disabled")
						@ui.OnlineDot(false)
					</td>
					<td data-slot="actions"></td>
				</tr>
			}
		}
		@galleryItem("Table with pager") {
			@ui.TablePaged("Pager sample", []string{"Name"}, ui.PageProps{Page: 2, Pages: 5, Href: galleryHref, Total: 48, Per: 10}) {
				<tr><td data-label="Name">alice</td></tr>
			}
		}
		@galleryItem("Empty, skeleton") {
			@ui.EmptyState("Nothing here yet", "Things you add will show up here.") {
				@ui.Button("secondary", "Add one", nil)
			}
			<div class="c-card l-stack u-grow" data-pad aria-busy="true">
				<div class="c-skel" data-w="40"></div>
				<div class="c-skel"></div>
				<div class="c-skel" data-w="80"></div>
				<div class="c-skel" data-size="lg"></div>
			</div>
		}
		@galleryItem("List rows, key and value, steps") {
			<div class="c-card l-narrow" data-pad>
				<h3 class="c-group-title">Expiring soon</h3>
				<div class="c-li">
					<span class="c-icon-circle" data-tone="warn">
						@ui.IconAs("clock", "s", "")
					</span>
					<div class="u-grow">
						<b>room204</b>
						<small>Premium 10 GB</small>
					</div>
					@ui.Pill("expiring", "2 days left")
				</div>
				<dl class="c-kv">
					<div><dt>Last login request</dt><dd>12 s ago</dd></div>
					<div><dt>Last accounting packet</dt><dd>8 s ago</dd></div>
				</dl>
				<ol class="c-steps">
					<li>Download the pages.</li>
					<li>Upload them to the router.</li>
				</ol>
			</div>
		}
		@galleryItem("Menu, sheet, modal, toast") {
			@ui.Menu("g-menu", "More") {
				@ui.MenuItemIcon("edit", "Edit", false, nil)
				@ui.MenuItemIcon("clock", "Renew", false, nil)
				@ui.MenuSep()
				@ui.MenuItemIcon("trash", "Delete", true, nil)
			}
			@ui.Button("secondary", "Open sheet", templ.Attributes{"data-open-dialog": "g-sheet"})
			@ui.Button("secondary", "Open modal", templ.Attributes{"data-open-dialog": "g-modal"})
			@ui.Button("secondary", "Confirm (hx-confirm)", templ.Attributes{"hx-get": "/admin/dev/components", "hx-confirm": "Do the thing?", "hx-swap": "none"})
			@ui.Button("secondary", "Show toast", templ.Attributes{"data-toast": "Saved."})
			@ui.Button("secondary", "Show error toast", templ.Attributes{"data-toast": "Could not save. Try again.", "data-toast-kind": "error"})
		}
		@galleryItem("Notice with a title") {
			<div class="l-narrow">
				@ui.NoticeTitled("ok", "alice is ready", "Give these details to the guest.")
			</div>
		}
		@galleryItem("Credentials") {
			<div class="l-narrow">
				@ui.Credentials([]ui.CredRow{{Label: "Username", Value: "alice"}, {Label: "Password", Value: "493021"}})
				@ui.KeyValues([]ui.CredRow{{Label: "Plan", Value: "Premium"}, {Label: "Valid until", Value: "No expiry"}})
			</div>
		}
		@galleryItem("Credentials in a sheet (after a member is created)") {
			@ui.Button("secondary", "Open sheet", templ.Attributes{"data-open-dialog": "g-cred-sheet"})
		}
		@galleryItem("Code block") {
			<div class="l-narrow">
				@ui.CodeBlock("g-code", "/ip hotspot print")
			</div>
		}
		@galleryItem("Bar chart") {
			<div class="l-narrow">
				@ui.BarChart([]ui.Bar{{Label: "Mon", Value: 3}, {Label: "Tue", Value: 8}, {Label: "Wed", Value: 5}, {Label: "Thu", Value: 10}}, 10, "sample")
			</div>
		}
		@galleryItem("Plots (dashboard charts)") {
			<div class="l-cols" data-cols="3">
				<div class="c-card" data-pad>
					<div class="c-card__head"><h2 class="c-card__title">Area</h2></div>
					@ui.Plot(ui.PlotArea, galleryBars(24, "00:00"), 10, "Area sample")
				</div>
				<div class="c-card" data-pad>
					<div class="c-card__head"><h2 class="c-card__title">Bars</h2></div>
					@ui.Plot(ui.PlotBars, galleryBars(7, "Mon"), 10, "Bar sample")
				</div>
				<div class="c-card" data-pad>
					<div class="c-card__head"><h2 class="c-card__title">Dots</h2></div>
					@ui.Plot(ui.PlotDots, galleryBars(7, "Mon"), 10, "Dot sample")
				</div>
			</div>
		}
		@galleryItem("Tiles") {
			@ui.Tiles() {
				@ui.Tile("Online now", nil) {
					@ui.TileValue("12", nil)
					@ui.TileNote("Peak today: 18", nil)
				}
				@ui.Tile("Traffic today (so far)", nil) {
					@ui.TileValue("3.4 GB", nil)
					@ui.TileNote("Yesterday 4.1 GB: -17%", nil)
				}
			}
		}
		@galleryItem("Icons") {
			for _, n := range []string{"home", "users", "wifi", "layers", "ticket", "chart", "router", "settings", "key", "sun", "moon", "logout", "more", "check-circle", "clock", "alert", "arrow-down", "arrow-up", "chevron-right", "chevron-left", "chevron-down", "printer", "plus", "eye", "wand", "trash", "copy", "x", "slash", "search", "power", "info", "edit", "download", "circle"} {
				@ui.Icon(n)
			}
		}
		@ui.Sheet("g-sheet", "Sample sheet") {
			@ui.SheetBody() {
				@ui.SheetForm(templ.Attributes{"id": "g-sheet-form"}) {
					@ui.Field(ui.FieldProps{Label: "Name", Name: "g_sheet_name"})
					@ui.Field(ui.FieldProps{Label: "With error", Name: "g_sheet_err", Value: "x", Error: "This value is not valid."})
				}
				@ui.SheetSection("Actions", nil) {
					@ui.Actions() {
						@ui.Button("secondary", "Renew", nil)
						@ui.Button("danger", "Delete", nil)
						@ui.LinkButton("ghost", "#", "Open details", nil)
					}
				}
			}
			@ui.SheetFoot() {
				@ui.Button("secondary", "Cancel", templ.Attributes{"data-close": true})
				@ui.Button("primary", "Save", nil)
			}
		}
		@ui.Sheet("g-cred-sheet", "Member created") {
			@MemberCreated(createdVM{ID: 1, Username: "alice", Password: "493021", Plan: "Premium", Expires: "No expiry", Devices: "2"})
		}
		@ui.Modal("g-modal", "Delete member?", "This cannot be undone.") {
			@ui.Button("secondary", "Cancel", templ.Attributes{"data-close": true})
			@ui.Button("danger", "Delete", templ.Attributes{"data-close": true})
		}
	}
}

// galleryHref returns the anchor link to gallery page n.
func galleryHref(n int) string { return "#page-" + string(rune('0'+n)) }

// galleryBars returns n sample values for the plot samples of the gallery.
func galleryBars(n int, label string) []ui.Bar {
	out := make([]ui.Bar, n)
	for i := range out {
		out[i] = ui.Bar{Label: label, Value: int64(2 + (i*7)%9), Tip: "sample"}
	}
	return out
}
