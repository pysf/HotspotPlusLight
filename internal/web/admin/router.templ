package admin

import (
	"hotspotpluslight/internal/routerpack"
	"hotspotpluslight/internal/web/ui"
)

templ RouterPage(l ui.LayoutData, p RouterProps) {
	@ui.Layout(l) {
		@ui.PageHeader("Router")
		if p.NoBaseURL {
			<div class="c-notice" data-kind="warn" data-warning="public-base-url">
				The public base URL is not set, so the login page cannot reach this server.
				Set it in <a href="/admin/settings">Settings</a> before you download the folder.
			</div>
		}
		<div class="l-gap-bottom">
			@ui.Card() {
				@ui.CardTitle("Login page")
				<p class="l-gap-bottom">
					The member login page lives on the router. Download the hotspot folder, edit <code>login.html</code>
					(footer, colors, translations), replace <code>logo.png</code> and <code>background.jpg</code>, and upload
					the folder to the router.
				</p>
				@ui.Actions() {
					@ui.LinkButton("primary", "/admin/router/files.zip", "Download hotspot folder", nil)
					@ui.LinkButton("secondary", "/admin/router/themes", "Choose another theme", nil)
					<span class="u-muted">Default theme: { p.DefaultTheme }</span>
				}
			}
		</div>
		<div class="l-gap-bottom">
			@ui.Card() {
				@ui.CardTitle("Router setup script")
				<p class="l-gap-bottom">
					Paste this into a RouterOS terminal. It contains the RADIUS shared secret, so do not share it.
					Each command is marked VERIFY-ON-HARDWARE until it has been checked on your router.
				</p>
				@ui.CodeBlock("setup-script", p.Script)
			}
		</div>
		@LinkStatusPanel(p.Link)
	}
}

// LinkStatusPanel shows what the router last sent. It lives in memory and starts empty after a restart.
templ LinkStatusPanel(v linkView) {
	<div data-link-status>
		<h2 class="l-gap-bottom">Router link status</h2>
		<p class="u-muted l-gap-bottom">Since the server started. A wrong shared secret on the router shows up as bad-secret packets.</p>
		@ui.Table("Router link status", []string{"", "When", "Router address", "Result"}) {
			for _, e := range v.Events {
				<tr data-link={ e.Key }>
					<td data-label="Event">{ e.Label }</td>
					<td data-at data-label="When" class="u-nums">{ e.At }</td>
					<td data-from data-label="Router address">{ e.From }</td>
					<td data-detail data-label="Result">{ e.Detail }</td>
				</tr>
			}
		}
		<p class="l-gap-bottom">Packets with a wrong shared secret: <strong class="u-nums" data-bad-secret-count>{ v.BadTotal }</strong></p>
		if len(v.BadSources) > 0 {
			<div data-bad-secret-sources>
				@ui.Table("Wrong shared secret sources", []string{"Source address", "Packets", "Last seen"}) {
					for _, b := range v.BadSources {
						<tr data-bad-secret-from={ b.From }>
							<td data-label="Source address">{ b.From }</td>
							<td data-count data-label="Packets" class="u-nums">{ b.Count }</td>
							<td data-at data-label="Last seen" class="u-nums">{ b.At }</td>
						</tr>
					}
				}
			</div>
		}
	</div>
}

templ ThemeGalleryPage(l ui.LayoutData, groups []themeGroup) {
	@ui.Layout(l) {
		@ui.PageHeader("Themes")
		for _, g := range groups {
			<section class="l-section" data-category={ g.Category }>
				<h2>{ g.Category }</h2>
				<div class="l-grid">
					for _, t := range g.Themes {
						<div data-theme={ t.ID } data-primary={ t.Primary } data-overlay={ t.Overlay }>
							<div class="c-card">
								<a data-detail href={ templ.SafeURL(themeURL(t.ID)) }>
									<img class="c-theme-card__img" loading="lazy" alt={ t.Title } src={ themeURL(t.ID) + "/background.jpg" }/>
								</a>
								<div class="c-theme-card__foot">
									@Swatch(t.Primary)
									@Swatch(t.Overlay)
									<span data-title>{ t.Title }</span>
								</div>
							</div>
						</div>
					}
				</div>
			</section>
		}
	}
}

templ ThemePage(l ui.LayoutData, t routerpack.Theme) {
	@ui.Layout(l) {
		@ui.PageHeader(t.Category + " / " + t.Title) {
			@ui.LinkButton("primary", downloadURL(t.ID), "Download hotspot folder", templ.Attributes{"data-download": true})
			@ui.LinkButton("secondary", "/admin/router/themes", "All themes", nil)
		}
		<iframe class="c-preview" data-preview sandbox="allow-scripts" title="Preview" src={ themeURL(t.ID) + "/login.html" }></iframe>
	}
}

// Swatch is a small color dot. The color is an SVG fill attribute, so no style attribute is needed.
templ Swatch(color string) {
	<span class="c-swatch">
		<svg viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="5" fill={ color }></circle></svg>
	</span>
}
