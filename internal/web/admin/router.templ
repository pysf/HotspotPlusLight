package admin

import "hotspotpluslight/internal/web/ui"

// RouterPage shows the page designs and the setup script.
templ RouterPage(l ui.LayoutData, p RouterProps) {
	@ui.Layout(l) {
		@ui.PageHeader("Router")
		<div class="l-gap-bottom">
			@ui.Card() {
				@ui.CardTitle("Login pages")
				<p class="l-gap-bottom">
					The login pages live on the router. Pick a design and download it as a zip. Unzip it, then drag the
					<code>hotspot</code> folder into Files on the router and replace the old one. On routers with flash storage
					the folder is <code>flash/hotspot</code>. Keep the hotspot profile on PAP (<code>login-by=http-pap</code>); if you turn on http-chap, logins fail.
				</p>
				<p class="l-gap-bottom">
					To change the heading, the subtitle or the logo, open <code>login.html</code> in a text editor. Comments in
					the file show where. To translate, change the text in the block called MESSAGES in <code>login.html</code>,
					the text in <code>errors.txt</code> and the labels in the other pages.
					The MikroTik default pages are the ones RouterOS ships. A failed login shows the raw code there, for example OUT_OF_BULK.
				</p>
			}
		</div>
		<section class="l-gap-bottom" aria-label="Page designs">
			<div class="l-grid">
				for _, d := range p.Designs {
					<div data-design={ d.Key }>
						@ui.Card() {
							@ui.CardTitle(d.Title)
							<p class="u-muted l-gap-bottom">{ d.About }</p>
							<iframe class="c-pack-frame l-gap-bottom" loading="lazy" tabindex="-1" title={ d.Title + " preview" } src={ previewURL(d.Key) }></iframe>
							@ui.Actions() {
								@ui.LinkButton("primary", zipURL(d.Key), "Download", templ.Attributes{"data-download": true})
								@ui.LinkButton("secondary", previewURL(d.Key), "Open preview", templ.Attributes{"data-preview": true, "target": "_blank", "rel": "noopener"})
							}
						}
					</div>
				}
			</div>
		</section>
		<div class="l-gap-bottom">
			@ui.Card() {
				@ui.CardTitle("Router setup script")
				<p class="l-gap-bottom">
					Paste this into a RouterOS terminal. It contains the RADIUS shared secret, so do not share it.
					Each command is marked VERIFY-ON-HARDWARE until it has been checked on your router.
				</p>
				@ui.CodeBlock("setup-script", p.Script)
			}
		</div>
	}
}
