package admin

import (
	"fmt"
	"strconv"
	"strings"

	"hotspotpluslight/internal/domain"
	"hotspotpluslight/internal/voucher"
	"hotspotpluslight/internal/web/ui"
)

// plural returns n with noun, in the plural form unless n is 1 ("es" after "ch").
func plural(n int, noun string) string {
	if n == 1 {
		return "1 " + noun
	}
	if strings.HasSuffix(noun, "ch") {
		return strconv.Itoa(n) + " " + noun + "es"
	}
	return strconv.Itoa(n) + " " + noun + "s"
}

// deleteBatchConfirm is the text of the confirmation dialog: member and online counts (BR-23b).
func deleteBatchConfirm(r domain.BatchRow) string {
	return fmt.Sprintf("Delete this batch? %s will be deleted (%d online, disconnected first).", plural(r.Members, "member"), r.Online)
}

// labelText returns the batch label, or a placeholder when it is empty.
func labelText(l string) string {
	if l == "" {
		return "(no label)"
	}
	return l
}

// BatchesPage lists the batches.
templ BatchesPage(l ui.LayoutData, res voucher.ListResult) {
	@ui.Layout(l) {
		@ui.PageHeader("Vouchers") {
			@ui.LinkButton("primary", "/admin/batches/new", "New batch", nil)
		}
		if res.Total == 0 {
			@ui.EmptyState("No batches yet", "Create the first one.")
		} else {
			@ui.TablePaged("Batches", []string{"Label", "Rename", "Plan", "Created", "Members", "Unused", ""}, ui.PageProps{Page: res.Page, Pages: res.Pages, Href: batchesHref(res.Per), Total: res.Total, Per: res.Per}) {
				for _, r := range res.Rows {
					@BatchRow(r, res)
				}
			}
		}
	}
}

// BatchRow is one row of the batch list.
templ BatchRow(r domain.BatchRow, res voucher.ListResult) {
	<tr data-batch data-id={ strconv.FormatInt(r.Batch.ID, 10) } data-members={ strconv.Itoa(r.Members) } data-online={ strconv.Itoa(r.Online) }>
		<td data-col="label" data-label="Label">{ labelText(r.Batch.Label) }</td>
		<td data-col="rename" data-label="Rename">
			<form class="l-split" hx-put={ batchURL(r.Batch.ID) } hx-target="#flash" hx-swap="innerHTML">
				<input name="label" class="c-input" value={ r.Batch.Label } maxlength="100" aria-label="Label"/>
				@ui.Button("secondary", "Save", templ.Attributes{"type": "submit"})
			</form>
		</td>
		<td data-col="plan" data-label="Plan">{ r.PlanName }</td>
		<td data-col="created" data-label="Created" class="u-nums">{ fmtTime(r.Batch.CreatedAt, res.Loc) }</td>
		<td data-col="members" data-label="Members" class="u-nums">{ strconv.Itoa(r.Members) }</td>
		<td data-col="unused" data-label="Unused" class="u-nums">{ strconv.Itoa(r.Unused) }</td>
		<td data-slot="actions">
			@ui.Actions() {
				@ui.LinkButton("secondary", batchURL(r.Batch.ID)+"/vouchers", "Reprint", templ.Attributes{"data-reprint": true, "target": "_blank", "rel": "noopener"})
				@ui.ConfirmDelete("Delete", batchURL(r.Batch.ID), deleteBatchConfirm(r))
			}
		</td>
	</tr>
}

// BatchNewPage shows the new batch form.
templ BatchNewPage(l ui.LayoutData, p BatchFormProps) {
	@ui.Layout(l) {
		@ui.PageHeader("New batch")
		if len(p.Plans) == 0 {
			@ui.EmptyState("No plans yet", "No plans exist yet. Create a plan first, then create batches.") {
				@ui.LinkButton("primary", "/admin/plans/new", "New plan", nil)
			}
		} else {
			@BatchFormView(p)
		}
	}
}

// BatchFormProps holds what the batch form shows.
type BatchFormProps struct {
	Form     domain.BatchForm
	Errors   domain.FieldErrors
	Plans    []domain.Plan
	Conflict string // shown above the form when a generated username already exists
}

// BatchFormView is the new-batch form and its 422 / 409 response body.
templ BatchFormView(p BatchFormProps) {
	@ui.FormCard(templ.Attributes{"id": "batch-form", "hx-post": "/admin/batches", "hx-target": "this", "hx-swap": "outerHTML"}) {
		if p.Conflict != "" {
			@ui.Flash("error", p.Conflict)
		}
		@ui.Field(ui.FieldProps{Label: "Label", Name: "label", Value: p.Form.Label, Error: p.Errors["label"], Hint: "Optional, for your own reference."})
		@ui.Select(ui.SelectProps{Label: "Plan", Name: "plan_id", Value: p.Form.PlanID, Options: planFilterOptions(p.Plans, "Choose a plan"), Error: p.Errors["plan_id"]})
		@ui.Field(ui.FieldProps{Label: "How many vouchers", Name: "count", Value: p.Form.Count, Error: p.Errors["count"], Hint: "From 1 to the maximum set in Settings.", Attrs: templ.Attributes{"inputmode": "numeric"}})
		@ui.Field(ui.FieldProps{Label: "Valid for (days)", Name: "duration_days", Value: p.Form.DurationDays, Error: p.Errors["duration_days"], Hint: "Optional. Empty = the plan's validity. Vouchers expire at midnight after this many days plus one, in the Settings time zone.", Attrs: templ.Attributes{"inputmode": "numeric"}})
		@ui.Actions() {
			@ui.Button("primary", "Create and print", templ.Attributes{"type": "submit"})
			@ui.LinkButton("secondary", "/admin/batches", "Cancel", nil)
		}
	}
}
