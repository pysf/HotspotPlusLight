<!DOCTYPE html>
<!--
  HotspotPlusLight starter login page.
  This file is stored on the MikroTik router (hotspot folder) and edited by hand:
    - colors: the two CSS variables below; replace background.jpg and logo.png in the same folder
    - texts: the site title and the footer
    - translations: English only; to add a language copy the "en" block of HSP_MESSAGES in the script and set HSP_LANG
  The router replaces its dollar-parenthesis variables when it serves this file.
  VERIFY-ON-HARDWARE: variable names, the form fields (username, password, dst, popup) and the login URL.
-->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="pragma" content="no-cache">
<meta http-equiv="expires" content="-1">
<title>{{html .SiteTitle}}</title>
<style>
:root {
  --primary-color: {{.Primary}};
  --overlay-color: {{.Overlay}};
}
* { box-sizing: border-box; }
body {
  margin: 0;
  min-height: 100vh;
  background: url("background.jpg") center center / cover no-repeat fixed;
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  font-size: 15px;
  line-height: 1.5;
  color: #fff;
}
.overlay {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px 16px;
  background: var(--overlay-color);
}
.panel { width: 100%; max-width: 360px; text-align: center; }
#logo { display: block; width: 120px; max-width: 40%; margin: 0 auto 16px; }
#site-title { margin: 0 0 20px; font-size: 22px; font-weight: 600; }
input[type=text], input[type=password] {
  display: block;
  width: 100%;
  height: 50px;
  margin: 0 0 14px;
  padding: 0 20px;
  border: 0;
  border-radius: 50px;
  background: rgba(255, 255, 255, 0.15);
  color: #fff;
  font: inherit;
  text-align: center;
  direction: ltr;
}
input::placeholder { color: #fff; opacity: 0.8; }
input:focus { outline: 2px solid #fff; }
#login-button {
  width: 100%;
  height: 50px;
  border: 0;
  border-radius: 50px;
  background: var(--primary-color);
  color: #fff;
  font: inherit;
  font-weight: 600;
  cursor: pointer;
}
#error-message {
  margin: 0 0 14px;
  padding: 10px 14px;
  border-radius: 12px;
  background: rgba(0, 0, 0, 0.45);
}
#hint { margin: 18px 0 0; font-size: 13px; opacity: 0.85; }
#footer { margin-top: 24px; font-size: 13px; opacity: 0.85; }
[hidden] { display: none !important; }
</style>
</head>
<body>
<div class="overlay">
  <main class="panel">
    <img id="logo" src="logo.png" alt="">
    <h1 id="site-title">{{html .SiteTitle}}</h1>
    <form id="login-form" name="login" action="$(link-login-only)" method="post">
      <input type="hidden" name="dst" value="$(link-orig)">
      <input type="hidden" name="popup" value="true">
      <input type="text" id="username" name="username" data-router-value="$(username)" data-i18n-placeholder="USERNAME" placeholder="Username" autocomplete="username" autocapitalize="none" autocorrect="off" spellcheck="false" required>
      <input type="password" id="password" name="password" data-i18n-placeholder="PASSWORD" placeholder="Password" autocomplete="current-password" required>
      <p id="error-message" role="alert" hidden></p>
      <button type="submit" id="login-button" data-i18n="LOGIN">Log in</button>
    </form>
    <p id="hint" data-i18n="DISCONNECTED_HINT">If you were disconnected, your plan's data or time may be used up. Try logging in again to see why.</p>
    <p id="footer">Edit this footer text in login.html.</p>
    <!-- The router puts its own login error here; the script translates it. -->
    <p id="router-error" hidden>$(error)</p>
  </main>
</div>
<script>
// ---- configuration -------------------------------------------------------
// Language of the dictionary below. To add a language by hand: copy the whole "en" block, give the copy a
// new key (e.g. de: { ... }), translate the texts, then set HSP_LANG to that key (the page lays out left-to-right; a right-to-left language would also need `dir="rtl"` added by hand). A code missing from the
// chosen table falls back to the English text.
var HSP_LANG = "en";

// ---- translations, keyed by message code ---------------------------------
// The server sends only a code. A code missing here shows the generic error and the raw code.
var HSP_MESSAGES = {
  en: {
{{- range .Messages}}
    {{.Code}}: {{js .Text}},
{{- end}}
    DISCONNECTED_HINT: "If you were disconnected, your plan's data or time may be used up. Try logging in again to see why.",
    USERNAME: "Username",
    PASSWORD: "Password",
    LOGIN: "Log in"
  }
};

// ---- script ----------------------------------------------------------------
// TODO(12b): temporary page script. Phase 12b replaces the whole pack with pages that need no JavaScript.
(function () {
  "use strict";
  var form = document.getElementById("login-form");
  var errorBox = document.getElementById("error-message");

  function text(code) {
    var table = HSP_MESSAGES[HSP_LANG] || {};
    return table[code] || HSP_MESSAGES.en[code] || "";
  }

  // Router variables the router did not substitute (e.g. a preview in the admin panel) count as empty.
  function routerValue(s) { s = (s || "").trim(); return s.indexOf("\x24(") === 0 ? "" : s; }

  function translatePage() {
    var els = document.querySelectorAll("[data-i18n]");
    for (var i = 0; i < els.length; i++) { els[i].textContent = text(els[i].getAttribute("data-i18n")) || els[i].textContent; }
    els = document.querySelectorAll("[data-i18n-placeholder]");
    for (var j = 0; j < els.length; j++) { els[j].placeholder = text(els[j].getAttribute("data-i18n-placeholder")) || els[j].placeholder; }
  }

  function showError(code, fallback) {
    errorBox.textContent = (code && text(code)) || fallback || text("GENERAL_ERROR");
    errorBox.hidden = false;
  }

  // The router's own error. For a RADIUS reject it is the reply message, which is only the code (e.g. OUT_OF_BULK).
  // VERIFY-ON-HARDWARE: that $(error) carries the RADIUS Reply-Message.
  function showRouterError() {
    var raw = routerValue(document.getElementById("router-error").textContent);
    if (!raw) { return; }
    if (!/^[A-Z_]+$/.test(raw)) { showError(null, raw); }
    else if (text(raw)) { showError(raw, null); }
    else { showError(null, text("GENERAL_ERROR") + " (" + raw + ")"); }
  }

  translatePage();
  var presetUser = routerValue(form.elements.username.getAttribute("data-router-value"));
  if (presetUser) { form.elements.username.value = presetUser; }
  showRouterError();
})();
</script>
</body>
</html>
